# Kai Suite Demo — plantilla (sin secretos reales).
# Materializar: ./_shared/scripts/render-tenant-env.sh kai-suite-demo

KAI_PRODUCT=kaisuite
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=true
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=all
KAI_DEPLOY_APPS=backend,admin,pos,stock,eshop,delivery,landing,waiter,kds,board,menu,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

# Seed dual Store + Food
KAI_SEED_MODE=suite

STORAGE_STRATEGY=local

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai_suite_demo
DB_DATABASE=kai_suite_demo

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=kai-suite-demo:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041

KAI_BACKEND_PORT=5360
KAI_ADMIN_PORT=5371
KAI_POS_PORT=5362
KAI_STOCK_PORT=5363
KAI_ESHOP_PORT=5364
KAI_DELIVERY_PORT=5365
KAI_LANDING_PORT=5366
KAI_WAITER_PORT=5367
KAI_KDS_PORT=5368
KAI_BOARD_PORT=5369
KAI_MENU_PORT=5370
LANDING_PRODUCT=suite

KAI_BACKEND_URL=http://localhost:5360
BACKEND_API_URL=http://localhost:5360
