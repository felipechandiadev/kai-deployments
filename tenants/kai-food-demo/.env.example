# KaiFood demo — copiar a .env en el servidor (no commitear)
# Valores alineados a tenants-registry (database / redis / sharedServices).

KAI_PRODUCT=kaifood
KAI_FEATURE_JEWELRY=false
KAI_DEPLOY_PROFILE=retail-full
KAI_DEPLOY_APPS=backend,admin,pos,stock,waiter,kds,board,mail,landing

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai_food_demo
DB_DATABASE=kai_food_demo
# DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=kai-food-demo:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_VOICE_URL=http://localhost:5041

# Puertos / URLs (serie ~516x; no chocar con kai-store-demo)
# KAI_BACKEND_PORT=5160
# KAI_ADMIN_PORT=5171
# KAI_POS_PORT=5162
# KAI_WAITER_PORT=5167
# KAI_KDS_PORT=5168
# NEXTAUTH_SECRET=
