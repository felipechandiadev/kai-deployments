# KaiFood demo — copiar a .env en el servidor (no commitear)

KAI_PRODUCT=kaifood
KAI_FEATURE_JEWELRY=false
KAI_DEPLOY_PROFILE=retail-full
KAI_DEPLOY_APPS=backend,admin,pos,stock,waiter,kds,board,mail,landing

# Puertos / URLs (ajustar por host; no chocar con kai-store-demo en el mismo VPS)
# KAI_BACKEND_PORT=
# KAI_ADMIN_PORT=
# KAI_POS_PORT=
# KAI_WAITER_PORT=
# KAI_KDS_PORT=
# DATABASE_URL=
# REDIS_URL=
# REDIS_KEY_PREFIX=kai-food-demo:
# NEXTAUTH_SECRET=
