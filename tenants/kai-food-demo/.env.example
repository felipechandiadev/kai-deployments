# KaiFood demo — plantilla (sin secretos reales).
# Materializar: ./_shared/scripts/render-tenant-env.sh kai-food-demo
# Valores de topología los pisa el registry (puertos 516x, DB, product).

KAI_PRODUCT=kaifood
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=false
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=retail-full
KAI_DEPLOY_APPS=backend,admin,pos,stock,waiter,kds,board,landing,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai_food_demo
DB_DATABASE=kai_food_demo
# DB_PASSWORD=   # default dev: kai123 (lo setea render-tenant-env)

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=kai-food-demo:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041
# KAI_MAIL_API_KEY=

KAI_BACKEND_PORT=5160
KAI_ADMIN_PORT=5161
KAI_POS_PORT=5162
KAI_STOCK_PORT=5163
KAI_LANDING_PORT=5166
LANDING_PRODUCT=food
KAI_WAITER_PORT=5167
KAI_KDS_PORT=5168
KAI_BOARD_PORT=5169

KAI_BACKEND_URL=http://localhost:5160
BACKEND_API_URL=http://localhost:5160
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5160

ADMIN_NEXTAUTH_URL=http://localhost:5161
POS_NEXTAUTH_URL=http://localhost:5162
STOCK_NEXTAUTH_URL=http://localhost:5163
# ADMIN_NEXTAUTH_SECRET=
# POS_NEXTAUTH_SECRET=
# STOCK_NEXTAUTH_SECRET=

# JWT / fiscal — si faltan, sync usa fragmentos del suite o completá aquí
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# FISCAL_ENCRYPTION_KEY=

STORAGE_STRATEGY=cloudflare

# Storage (R2 / S3-compatible) — copy values from kai-suite/envs/shared.env
R2_ACCOUNT_ID=<from shared.env>
R2_ENDPOINT=<from shared.env>
R2_ACCESS_KEY_ID=<from shared.env>
R2_SECRET_ACCESS_KEY=<from shared.env>
R2_BUCKET_NAME=kai-demo
R2_PUBLIC_URL=https://pub-0627c65d886244ee8d96266ea40feb54.r2.dev
