# Barco — plantilla env (sin secretos reales).
# Empresa única Ohlala (kaifood) con sucursales Ohlala + El Barco.
# Materializar: ./_shared/scripts/render-tenant-env.sh barco

KAI_PRODUCT=kaisuite
KAI_SEED_PROFILE=barco
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=false
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=suite-pos
KAI_DEPLOY_APPS=backend,admin,pos,stock,waiter,menu,board,kds,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=barco
DB_DATABASE=barco

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=barco:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041

KAI_BACKEND_PORT=5260
KAI_ADMIN_PORT=5271
KAI_POS_PORT=5262
KAI_STOCK_PORT=5263
KAI_WAITER_PORT=5267
KAI_KDS_PORT=5268
KAI_BOARD_PORT=5269
KAI_MENU_PORT=5270

KAI_BACKEND_URL=http://localhost:5260
BACKEND_API_URL=http://localhost:5260
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5260
NEXT_PUBLIC_MENU_STORE_SLUG=ohlala

ADMIN_NEXTAUTH_URL=http://localhost:5271
POS_NEXTAUTH_URL=http://localhost:5262
STOCK_NEXTAUTH_URL=http://localhost:5263
MENU_NEXTAUTH_URL=http://localhost:5270
WAITER_NEXTAUTH_URL=http://localhost:5267
KDS_NEXTAUTH_URL=http://localhost:5268
BOARD_NEXTAUTH_URL=http://localhost:5269
STORAGE_STRATEGY=cloudflare

# Storage (R2 / S3-compatible) — copy values from kai-suite/envs/shared.env
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=barco
# R2_PUBLIC_URL=
