# Mias — plantilla env (sin secretos reales).
# Empresa KaiFood vacía operable. Materializar: ./_shared/scripts/render-tenant-env.sh mias

KAI_PRODUCT=kaisuite
KAI_SEED_PROFILE=mias
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=false
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=suite-pos
KAI_DEPLOY_APPS=backend,admin,pos,stock,menu,board,kds,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mias
DB_DATABASE=mias

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=mias:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041

KAI_BACKEND_PORT=5560
KAI_ADMIN_PORT=5571
KAI_POS_PORT=5562
KAI_STOCK_PORT=5563
KAI_KDS_PORT=5568
KAI_BOARD_PORT=5569
KAI_MENU_PORT=5570

KAI_BACKEND_URL=http://localhost:5560
BACKEND_API_URL=http://localhost:5560
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5560
NEXT_PUBLIC_MENU_STORE_SLUG=mias

ADMIN_NEXTAUTH_URL=http://localhost:5571
POS_NEXTAUTH_URL=http://localhost:5562
STOCK_NEXTAUTH_URL=http://localhost:5563
MENU_NEXTAUTH_URL=http://localhost:5570
KDS_NEXTAUTH_URL=http://localhost:5568
BOARD_NEXTAUTH_URL=http://localhost:5569
STORAGE_STRATEGY=local

# Storage (R2 / S3-compatible) — opcional
