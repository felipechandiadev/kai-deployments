# KaiStore demo — plantilla (sin secretos reales).
# Materializar: ./_shared/scripts/render-tenant-env.sh kai-store-demo

KAI_PRODUCT=kaistore
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=true
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=all
KAI_DEPLOY_APPS=backend,admin,pos,stock,eshop,delivery,landing,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai_store_demo
DB_DATABASE=kai_store_demo

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=kai-store-demo:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041

KAI_BACKEND_PORT=5060
KAI_ADMIN_PORT=5071
KAI_POS_PORT=5062
KAI_STOCK_PORT=5063
KAI_ESHOP_PORT=5064
KAI_DELIVERY_PORT=5065
KAI_LANDING_PORT=5066
LANDING_PRODUCT=store

KAI_BACKEND_URL=http://localhost:5060
BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5060
NEXT_PUBLIC_ESHOP_SITE_URL=http://localhost:5064

ADMIN_NEXTAUTH_URL=http://localhost:5071
POS_NEXTAUTH_URL=http://localhost:5062
STOCK_NEXTAUTH_URL=http://localhost:5063
