# KaiStore demo — copiar a .env en el servidor (no commitear)
# Valores alineados a tenants-registry (database / redis / sharedServices).

KAI_PRODUCT=kaistore
KAI_DEPLOY_PROFILE=all
KAI_FEATURE_ESHOP=true
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_MULTI_COMPANY=true
KAI_DEPLOY_APPS=backend,admin,pos,stock,eshop,delivery,mail,landing

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kai_store_demo
DB_DATABASE=kai_store_demo
# DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=kai-store-demo:

OSRM_URL=http://localhost:5001
# mail.mode=shared → URL de sharedServices.mail (default)
KAI_MAIL_URL=http://localhost:5040
# Si tenants[].mail.mode=dedicated, usá la url/port de ese tenant, p. ej.:
# KAI_MAIL_URL=http://localhost:5240
KAI_VOICE_URL=http://localhost:5041
# KAI_MAIL_API_KEY=

# Puertos / URLs (ajustar por host; ver tenants-registry)
# KAI_BACKEND_PORT=5060
# KAI_ADMIN_PORT=5071
# KAI_POS_PORT=5062
# KAI_STOCK_PORT=5063
# KAI_ESHOP_PORT=5064
# NEXTAUTH_SECRET=
