# Velarys — plantilla env (sin secretos reales).
# Empresa KaiFood. Materializar: ./_shared/scripts/render-tenant-env.sh velarys

KAI_PRODUCT=kaisuite
KAI_SEED_PROFILE=velarys
KAI_FEATURE_JEWELRY=false
KAI_FEATURE_ESHOP=false
KAI_FEATURE_MULTI_COMPANY=true
KAI_FEATURE_POS=true
KAI_FEATURE_STOCK=true
KAI_FEATURE_KAI_MAIL=true
KAI_DEPLOY_PROFILE=suite-pos
KAI_DEPLOY_APPS=backend,admin,pos,stock,waiter,menu,board,kds,mail
KAI_DEV_HOST=localhost
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=velarys
DB_DATABASE=velarys

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=velarys:

OSRM_URL=http://localhost:5001
KAI_MAIL_URL=http://localhost:5040
KAI_MAIL_PORT=5040
KAI_VOICE_URL=http://localhost:5041
KAI_VOICE_PORT=5041

KAI_BACKEND_PORT=5460
KAI_ADMIN_PORT=5471
KAI_POS_PORT=5462
KAI_STOCK_PORT=5463
KAI_WAITER_PORT=5467
KAI_KDS_PORT=5468
KAI_BOARD_PORT=5469
KAI_MENU_PORT=5470

KAI_BACKEND_URL=http://localhost:5460
BACKEND_API_URL=http://localhost:5460
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5460
NEXT_PUBLIC_MENU_STORE_SLUG=velarys

ADMIN_NEXTAUTH_URL=http://localhost:5471
POS_NEXTAUTH_URL=http://localhost:5462
STOCK_NEXTAUTH_URL=http://localhost:5463
MENU_NEXTAUTH_URL=http://localhost:5470
WAITER_NEXTAUTH_URL=http://localhost:5467
KDS_NEXTAUTH_URL=http://localhost:5468
BOARD_NEXTAUTH_URL=http://localhost:5469
STORAGE_STRATEGY=local

