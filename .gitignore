# Secrets & local overrides
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.pfx
*.key
id_ed25519*
id_rsa*

# Tenant registry (host ports / domains reales) — solo el example va a Git
tenants-registry.json
!tenants-registry.example.json

# Backups & dumps (never in git)
backups/
**/backups/**
!**/backups/.gitkeep
tenants/*/uploads/**
!tenants/*/uploads/.gitkeep
**/*.sql
**/*.sql.gz
**/*.dump
**/*.tar
**/*.tar.gz

# Barco: Firebird + JSONL son insumos locales para regenerar catálogo;
# el seed usa solo tenants/barco/seed/data/catalog-*.json
tenants/barco/*.FDB
tenants/barco/exports/PDVDATA*/
tenants/barco/exports/**/*.jsonl
tenants/barco/exports/**/_meta.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
!.vscode/extensions.json
