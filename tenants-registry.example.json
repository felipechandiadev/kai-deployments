{
  "version": 1,
  "description": "Plantilla del Tenant Registry — copiar a tenants-registry.json (gitignored). Sin secretos.",
  "baseDomain": "example.com",
  "portRanges": {
    "reservedSystem": "5000-5050",
    "tenantsRange": "5060-5999",
    "blockSizeHint": 100
  },
  "sharedServices": {
    "postgres": {
      "mode": "shared",
      "host": "localhost",
      "port": 5432,
      "engine": "postgis",
      "notes": "Una instancia PostGIS. Una database por tenant (tenants[].database)."
    },
    "redis": {
      "mode": "shared",
      "host": "localhost",
      "port": 6379,
      "notes": "Un Redis. Aislamiento vía tenants[].redisKeyPrefix → REDIS_KEY_PREFIX."
    },
    "osrm": {
      "mode": "shared",
      "url": "http://localhost:5001",
      "source": "kai-suite (backend OSRM / services/kai-osrm pendiente)",
      "notes": "Un OSRM para todos los backends (OSRM_URL)."
    },
    "mail": {
      "mode": "shared",
      "defaultMode": "shared",
      "url": "http://localhost:5040",
      "port": 5040,
      "notes": "Default compartido (global-services/mail). Override por tenant: tenants[].mail.mode = shared|dedicated. Dedicated exige url o port propios."
    },
    "voice": {
      "mode": "shared",
      "url": "http://localhost:5041",
      "port": 5041,
      "notes": "kai-voice compartido (KAI_VOICE_URL). Ops: global-services/voice/. TTS stateless — un proceso por host."
    },
    "proxy": {
      "mode": "shared",
      "ports": [80, 443],
      "notes": "Reverse proxy del host; vhosts desde tenants[].hosts/ports."
    }
  },
  "tenants": [
    {
      "id": "kai-store-demo",
      "name": "KaiStore Demo",
      "active": true,
      "environment": "staging",
      "product": "kaistore",
      "folder": "tenants/kai-store-demo",
      "baseDomain": "store-demo.example.com",
      "database": {
        "name": "kai_store_demo",
        "user": "kai_store_demo"
      },
      "redisKeyPrefix": "kai-store-demo:",
      "mail": {
        "mode": "shared"
      },
      "hosts": {
        "backend": "core.store-demo.example.com",
        "admin": "admin.store-demo.example.com",
        "pos": "pos.store-demo.example.com",
        "stock": "stock.store-demo.example.com",
        "eshop": "shop.store-demo.example.com",
        "delivery": "delivery.store-demo.example.com",
        "landing": "store-demo.example.com"
      },
      "ports": {
        "backend": 5060,
        "admin": 5071,
        "pos": 5062,
        "stock": 5063,
        "eshop": 5064,
        "delivery": 5065,
        "landing": 5066,
        "waiter": null,
        "kds": null,
        "board": null
      },
      "apps": {
        "web": {
          "backend": true,
          "admin": true,
          "pos": true,
          "stock": true,
          "eshop": true,
          "delivery": true,
          "waiter": false,
          "kds": false,
          "board": false,
          "landing": true
        },
        "native": {
          "printers": {
            "android": true,
            "windows": true,
            "macos": true
          },
          "cfd": {
            "android": true
          }
        }
      }
    },
    {
      "id": "kai-food-demo",
      "name": "KaiFood Demo",
      "active": true,
      "environment": "staging",
      "product": "kaifood",
      "folder": "tenants/kai-food-demo",
      "baseDomain": "food-demo.example.com",
      "database": {
        "name": "kai_food_demo",
        "user": "kai_food_demo"
      },
      "redisKeyPrefix": "kai-food-demo:",
      "mail": {
        "mode": "shared"
      },
      "hosts": {
        "backend": "core.food-demo.example.com",
        "admin": "admin.food-demo.example.com",
        "pos": "pos.food-demo.example.com",
        "stock": "stock.food-demo.example.com",
        "waiter": "waiter.food-demo.example.com",
        "kds": "kds.food-demo.example.com",
        "board": "board.food-demo.example.com",
        "landing": "food-demo.example.com"
      },
      "ports": {
        "backend": 5160,
        "admin": 5171,
        "pos": 5162,
        "stock": 5163,
        "eshop": null,
        "delivery": null,
        "landing": 5166,
        "waiter": 5167,
        "kds": 5168,
        "board": 5169
      },
      "apps": {
        "web": {
          "backend": true,
          "admin": true,
          "pos": true,
          "stock": true,
          "eshop": false,
          "delivery": false,
          "waiter": true,
          "kds": true,
          "board": true,
          "landing": true
        },
        "native": {
          "printers": {
            "android": true,
            "windows": true,
            "macos": true
          },
          "cfd": {
            "android": true
          }
        }
      }
    }
  ]
}
