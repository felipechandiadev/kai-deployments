{
  "version": 1,
  "description": "Plantilla del Tenant Registry — copiar a tenants-registry.json (gitignored). Sin secretos.",
  "baseDomain": "example.com",
  "portRanges": {
    "reservedSystem": "5000-5050",
    "tenantsRange": "5060-5999",
    "blockSizeHint": 100
  },
  "sharedServices": {
    "postgres": {
      "mode": "shared",
      "host": "localhost",
      "port": 5432,
      "engine": "postgis",
      "notes": "Una instancia PostGIS. Una database por tenant (tenants[].database)."
    },
    "redis": {
      "mode": "shared",
      "host": "localhost",
      "port": 6379,
      "notes": "Un Redis. Aislamiento vía tenants[].redisKeyPrefix → REDIS_KEY_PREFIX."
    },
    "osrm": {
      "mode": "shared",
      "url": "http://localhost:5001",
      "source": "kai-suite/services/kai-osrm",
      "notes": "Un OSRM para todos los backends (OSRM_URL)."
    },
    "mail": {
      "mode": "shared",
      "defaultMode": "shared",
      "url": "http://localhost:5040",
      "port": 5040,
      "notes": "Default compartido (global-services/mail). Override por tenant: tenants[].mail.mode = shared|dedicated. Dedicated exige url o port propios."
    },
    "voice": {
      "mode": "shared",
      "url": "http://localhost:5041",
      "port": 5041,
      "notes": "kai-voice compartido (KAI_VOICE_URL). Ops: global-services/voice/. TTS stateless — un proceso por host."
    },
    "proxy": {
      "mode": "shared",
      "ports": [
        80,
        443
      ],
      "notes": "Reverse proxy del host; vhosts desde tenants[].hosts/ports."
    }
  },
  "tenants": [
    {
      "id": "kai-suite-demo",
      "name": "Kai Suite Demo",
      "active": true,
      "environment": "staging",
      "product": "kaisuite",
      "folder": "tenants/kai-suite-demo",
      "seed": {
        "profile": "suite",
        "mode": "suite"
      },
      "baseDomain": "suite-demo.example.com",
